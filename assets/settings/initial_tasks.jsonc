// プロジェクトのタスク設定。ドキュメントは gram://docs/tasks を参照してください。
//
// 例:
[
  {
    "label": "Example task",
    "command": "for i in {1..5}; do echo \"Hello $i/5\"; sleep 1; done",
    // "args": [],
    // コマンド用の環境変数の上書き。設定のターミナル環境に追加されます。
    "env": { "foo": "bar" },
    // コマンドを実行するカレントディレクトリ。デフォルトは現在のプロジェクトルートです。
    // "cwd": "/path/to/working/directory",
    // プロセスの起動に新しいターミナルタブを使うか、既存のタブを再利用するか。デフォルトは `false` です。
    "use_new_terminal": false,
    // 同じタスクの複数インスタンスの実行を許可するか、既存のインスタンスの終了を待つか。デフォルトは `false` です。
    "allow_concurrent_runs": false,
    // コマンドの開始後、ターミナルペインとタブをどう扱うか:
    // * `always` — 常にタスクのペインを表示し、その中の対応するタブにフォーカスする（デフォルト）
    // * `no_focus` — 常にタスクのペインを表示し、その中にタスクのタブを追加するが、フォーカスはしない
    // * `never` — フォーカスは変更しないが、タスクのペイン内でタブの追加または再利用は行う
    "reveal": "always",
    // タスクの開始後、タスクのターミナル項目をどこに配置するか:
    // * `dock` — ターミナルドック内の "regular" なターミナル項目の位置（デフォルト）
    // * `center` — 中央のペイングループ、"main" のエディター領域
    "reveal_target": "dock",
    // コマンドの終了後、ターミナルペインとタブをどう扱うか:
    // * `never` — コマンドの終了時に何もしない（デフォルト）
    // * `always` — 常にターミナルタブを非表示にし、最後のタブだった場合はペインも非表示にする
    // * `on_success` — タスク成功時のみターミナルタブを非表示にし、それ以外は `always` と同様に動作する
    "hide": "never",
    // ターミナル内でタスクを実行するときに使うシェル。
    // 3 つの値を指定できます:
    // 1. (デフォルト) /etc/passwd のシステム既定のターミナル設定を使う
    //      "shell": "system"
    // 2. プログラムを指定する:
    //      "shell": {
    //        "program": "sh"
    //      }
    // 3. 引数付きのプログラムを指定する:
    //     "shell": {
    //         "with_arguments": {
    //           "program": "/bin/bash",
    //           "args": ["--login"]
    //         }
    //     }
    "shell": "system",
    // 起動したタスクの出力にタスク行を表示するか。デフォルトは `true` です。
    "show_summary": true,
    // 起動したタスクの出力にコマンドラインを表示するか。デフォルトは `true` です。
    "show_command": true,
    // インラインの実行可能インジケーターや、複数タスクの一括起動に使うタグを表します。
    // "tags": []
    // タスクの実行前に保存する編集済みバッファー:
    // * `none` — どのバッファーも保存しない
    // * `all` — 編集済みのバッファーをすべて保存する
    // * `current` — 現在のバッファーのみ保存する
    "save": "none",
  },
]
