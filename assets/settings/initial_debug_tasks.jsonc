// 一般的な言語向けのタスク例。
//
// デバッグタスクの設定方法の詳細は、
// 次を参照してください: gram://docs/debugger
[
  {
    "label": "Debug active Python file",
    "adapter": "Debugpy",
    "program": "$GRAM_FILE",
    "request": "launch",
    "cwd": "$GRAM_WORKTREE_ROOT"
  },
  {
    "label": "Debug active JavaScript file",
    "adapter": "JavaScript",
    "program": "$GRAM_FILE",
    "request": "launch",
    "cwd": "$GRAM_WORKTREE_ROOT",
    "type": "pwa-node"
  },
  {
    "label": "JavaScript debug terminal",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$GRAM_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "type": "pwa-node"
  }
]
