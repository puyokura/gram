{
  "$schema": "gram://schemas/settings",
  // UI で使用する Gram テーマの名前。
  //
  // `mode` には次のいずれかを指定します:
  // - "system": システムの外観に対応するテーマを使用する
  // - "light": "light" フィールドで指定したテーマを使用する
  // - "dark": "dark" フィールドで指定したテーマを使用する
  "theme": {
    "mode": "system",
    "light": "Melange Light",
    "dark": "Melange Dark",
  },
  "icon_theme": "Gram (Default)",
  // 使用する基本キーバインドセットの名前。
  // 指定可能な値は crates/settings/src/base_keymap_setting.rs の BaseKeymap
  // を参照してください。
  "base_keymap": "VSCode",
  // グローバルに有効化または無効化できる機能
  "features": {},
  // エディターのテキスト描画に使用するフォント名
  "buffer_font_family": ".GramMono",
  // バッファーテキストの代替フォントを設定します。null の場合はプラットフォーム別の
  // 日本語向け等幅フォントチェーンが自動適用されます（空配列 [] で無効化可能）。
  "buffer_font_fallbacks": null,
  // エディターのテキストで有効にする OpenType 機能。
  "buffer_font_features": {
    // 合字を無効化:
    "calt": false,
  },
  // エディターのテキストの既定フォントサイズ
  "buffer_font_size": 14,
  // エディターフォントの太さ。100〜900 の標準 CSS 単位で指定します。
  "buffer_font_weight": 400,
  // バッファーの行の高さを設定します。
  // 3 つの値を指定できます:
  //  1. 読みやすい行の高さを使用する (1.618)
  //         "buffer_line_height": "comfortable"
  //  2. 標準の行の高さを使用する (1.3)
  //         "buffer_line_height": "standard",
  //  3. カスタムの行の高さを使用する
  //         "buffer_line_height": {
  //           "custom": 2
  //         },
  "buffer_line_height": "comfortable",
  // UI のテキスト描画に使用するフォント名
  // ".SystemUIFont" を指定するとシステムフォントを使用します
  // ".GramSans" は現在 "IBM Plex Sans" の別名ですが、この対応は
  // 将来変更される可能性があります
  "ui_font_family": ".GramSans",
  // UI の代替フォントを設定します。null の場合はプラットフォーム別の
  // 日本語向け UI フォントチェーンが自動適用されます（空配列 [] で無効化可能）。
  "ui_font_fallbacks": null,
  // UI のテキストで有効にする OpenType 機能
  "ui_font_features": {
    // 合字を無効化:
    "calt": false,
  },
  // UI フォントの太さ。100〜900 の標準 CSS 単位で指定します。
  "ui_font_weight": 400,
  // UI のテキストの既定フォントサイズ
  "ui_font_size": 14,
  // 未使用のコードをどの程度フェードアウトするか。
  "unnecessary_code_fade": 0.3,
  /// クライアントサイドデコレーションを使用するプラットフォームでのウィンドウの角丸を定義します。
  "client_side_decoration_rounding": 10.0,
  /// クライアントサイドデコレーションを使用するプラットフォームでのウィンドウの影のサイズを定義します。
  "client_side_decoration_shadow": 10.0,
  // アクティブなペインのスタイル設定。
  "active_pane_modifiers": {
    // アクティブなペインの内側の境界線サイズ（ピクセル）。
    "border_size": 0.0,
    // 非アクティブなペインの不透明度。0 は透明、1 は不透明です。
    // 値は [0.0, 1.0] の範囲に丸められます。
    "inactive_opacity": 1.0,
  },
  // 下部ドックのレイアウトモード。デフォルトは "contained" です
  //   選択肢: contained、full、left_aligned、right_aligned
  "bottom_dock_layout": "contained",
  // ペインを水平方向に分割する向き。デフォルトは "down" です
  "pane_split_direction_horizontal": "down",
  // ペインを垂直方向に分割する向き。デフォルトは "right" です
  "pane_split_direction_vertical": "right",
  // 中央寄せレイアウトに関する設定。
  "centered_layout": {
    // 中央寄せレイアウト使用時の、ワークスペースに対する
    // 中央ペインの左パディングの相対幅。
    "left_padding": 0.2,
    // 中央寄せレイアウト使用時の、ワークスペースに対する
    // 中央ペインの右パディングの相対幅。
    "right_padding": 0.2,
  },
  // 画像ビューアーの設定
  "image_viewer": {
    // 画像ファイルサイズの単位: "binary"（KiB、MiB）または 10 進（KB、MB）
    "unit": "binary",
  },
  // マウスで複数カーソルを追加するときに使う修飾キーを指定します。ホバーリンクのマウスジェスチャーは、複数カーソル用の修飾キーと競合しないように調整されます。
  //
  // 1. Linux と Windows では `Alt`、macOS では `Option` に対応します:
  //    "alt"
  // 2. Linux と Windows では `Control`、macOS では `Command` に対応します:
  //    "cmd_or_ctrl" (alias: "cmd", "ctrl")
  "multi_cursor_modifier": "alt",
  // vim モードとキーバインドを有効にするか。
  "vim_mode": false,
  // helix モードとキーバインドを有効にするか。
  // このモードを有効にすると、vim モードも自動的に有効になります。
  "helix_mode": false,
  // エディター内のシンボルの上にマウスを移動したとき、情報を表示する
  // ホバーボックスを表示するか。
  "hover_popover_enabled": true,
  // 情報を表示するホバーボックスを表示するまでの待ち時間（ミリ秒）。
  "hover_popover_delay": 300,
  // Gram の終了前に確認を求めるか。
  "confirm_quit": false,
  // 新しい Gram インスタンスを開いたときに、最後に閉じたプロジェクトを復元するか
  // 4 つの値を指定できます:
  //  1. ランチパッド / ウェルカム画面を開く
  //         "restore_on_startup": "launchpad"
  //  2. 前回のセッションで開いていたすべてのワークスペース
  //         "restore_on_startup": "last_session"
  //  3. 最後に開いたワークスペース
  //         "restore_on_startup": "last_workspace",
  //  4. 以前のワークスペースを復元しない
  //         "restore_on_startup": "none",
  "restore_on_startup": "launchpad",
  // ファイルを再度開くときに、前回の状態の復元を試みるか。
  // 状態はペインごとに保存されます。
  // 無効にすると、状態の復元の代わりにデフォルトが適用されます。
  //
  // 例: エディターでは、同じファイルを同じペインで閉じてから後で再度開くと、選択範囲、折りたたみ、スクロール位置が復元されます。
  // 無効にすると、ファイル先頭の単一選択、スクロール位置 0、折りたたみなしがデフォルトとして使われます。
  //
  // デフォルト: true
  "restore_on_file_reopen": true,
  // ディスク上で削除されたファイルを自動的に閉じるか。
  "close_on_file_delete": false,
  // ドロップしたファイルを分割ペインで開くための、エディター内のドロップ領域の相対サイズ (0〜0.5)
  // 例: 0.25 の場合、ペインの上部または下部 4 分の 1 にドロップすると新しい垂直分割が使われ、
  //              ペインの左部または右部 4 分の 1 にドロップすると新しい水平分割が使われます
  "drop_target_size": 0.2,
  // タブのないウィンドウで「アクティブな項目を閉じる」を使ったときに、ウィンドウを閉じるか。
  // 3 つの値を指定できます:
  //  1. 現在のプラットフォームの慣例に従う
  //         "when_closing_with_no_tabs": "platform_default"
  //  2. 常にウィンドウを閉じる:
  //         "when_closing_with_no_tabs": "close_window",
  //  3. ウィンドウを閉じない
  //         "when_closing_with_no_tabs": "keep_window_open",
  "when_closing_with_no_tabs": "platform_default",
  // 最後のウィンドウが閉じられたときの動作。
  // 2 つの値を指定できます:
  //  1. 現在のプラットフォームの慣例に従う
  //         "on_last_window_closed": "platform_default"
  //  2. 常にアプリケーションを終了する
  //         "on_last_window_closed": "quit_app",
  "on_last_window_closed": "platform_default",
  // 使用するテキスト描画モード。
  // 3 つの値を指定できます:
  //  1. プラットフォームのデフォルト動作を使用する:
  //         "text_rendering_mode": "platform_default"
  //  2. サブピクセル（ClearType 形式）のテキスト描画を使用する:
  //         "text_rendering_mode": "subpixel"
  //  3. グレースケールのテキスト描画を使用する:
  //         "text_rendering_mode": "grayscale"
  "text_rendering_mode": "platform_default",
  // ズームしたパネルにパディングを表示するか。
  // 有効にすると、ズームした中央パネル（例: コードエディター）は全周にパディングが付き、
  // ズームした下部/左/右パネルはそれぞれ上/右/左にパディングが付きます。
  //
  // デフォルト: true
  "zoomed_padding": true,
  // Gram のウィンドウデコレーション（タイトルバー）を描画するもの:
  // 1. クライアントアプリケーションが自身のウィンドウデコレーションを描画する
  //    "client"
  // 2. ディスプレイサーバーがウィンドウデコレーションを描画する。GNOME Wayland ではサポートされません。
  //    "server"
  //
  // 変更を反映するには Gram の再起動が必要です。
  //
  // デフォルト: "client"
  "window_decorations": "client",
  // エディターがどの Option キーを「alt」として扱うか。
  // "both" に設定すると、右の Option キーも alt キーとして
  // 扱われます。"only_left"（デフォルト）に設定すると、
  // 右の Option キーは拡張テキスト入力用の AltGr として
  // 扱われます。（Mac のみ）
  //
  // デフォルト: "only_left"
  "option_as_alt": "only_left",

  // 「開く」と「名前を付けて保存」にシステム提供のダイアログを使うか。
  // false に設定すると、Gram は組み込みのキーボード優先ピッカーを使います。
  "use_system_path_prompts": true,
  // 確認プロンプトなどのプロンプトに、システム提供の
  // ダイアログを使うか。
  // false に設定すると、Gram は組み込みのプロンプトを使います。Linux ではこの
  // オプションは無視され、常に組み込みのプロンプトが使われます。
  "use_system_prompts": true,
  // エディターでカーソルを点滅させるか。
  "cursor_blink": true,
  // 既定のエディターのカーソル形状。
  //  1. 縦棒
  //     "bar"
  //  2. 後続の文字を囲むブロック
  //     "block"
  //  3. 後続の文字の下に沿う下線
  //     "underline"
  //  4. 後続の文字の周囲に描く枠
  //     "hollow"
  //
  // デフォルト: "bar"
  "cursor_shape": "bar",
  // スムーズなカーソル移動の設定。
  "smooth_cursor": {
    // スムーズカーソルを有効にするか。
    "enabled": false,
    // カーソル移動の時間（ミリ秒）。
    "duration_ms": 100,
  },
  // エディターや入力ボックスでマウスカーソルをいつ非表示にするか。
  //
  // 1. マウスカーソルを非表示にしない:
  //    "never"
  // 2. 入力中のみ非表示にする:
  //    "on_typing"
  // 3. 入力中とカーソル移動中の両方で非表示にする:
  //    "on_typing_and_movement"
  "hide_mouse": "on_typing_and_movement",
  // スニペットを他の補完項目に対してどのように並べるか。
  //
  // 1. スニペットを補完リストの先頭に置く:
  //    "top"
  // 2. スニペットを優先せず通常どおり並べる:
  //    "inline"
  // 3. スニペットを補完リストの末尾に置く:
  //    "bottom"
  // 4. 補完リストにスニペットを表示しない:
  //    "none"
  "snippet_sort_order": "inline",
  // エディターで現在行を強調表示する方法。
  //
  // 1. 現在行を強調表示しない:
  //    "none"
  // 2. ガター領域を強調表示する:
  //    "gutter"
  // 3. エディター領域を強調表示する:
  //    "line"
  // 4. 行全体を強調表示する（デフォルト）:
  //    "all"
  "current_line_highlight": "all",
  // エディターで選択テキストのすべての出現箇所を強調表示するか。
  "selection_highlight": true,
  // テキスト選択の角を丸めるか。
  "rounded_selection": true,
  // 現在のカーソル位置に基づいて言語サーバーに
  // ハイライトを問い合わせるまでのデバウンス遅延。
  "lsp_highlight_debounce": 75,
  // 前景色と背景色の間の最小 APCA 知覚コントラスト。
  // APCA（Accessible Perceptual Contrast Algorithm）は WCAG 2.x より正確で、
  // 特にダークモードに適しています。値の範囲は 0〜106 です。
  //
  // APCA Readability Criterion (ARC) の Bronze Simple Mode に基づきます:
  // https://readtech.org/ARC/tests/bronze-simple-mode/
  // - 0: コントラスト調整なし
  // - 45: 大きな流し読みテキストの最小値 (36px 以上)
  // - 60: その他のコンテンツテキストの最小値
  // - 75: 本文テキストの最小値
  // - 90: 本文テキストの推奨値
  //
  // これはエディターでハイライト背景の上に描画されるテキストにのみ影響します。
  "minimum_contrast_for_highlights": 45,
  // エディターで明示的に要求せずに入力したときに、
  // 補完メニューを自動的に表示するか。
  "show_completions_on_input": true,
  // 補完メニューの項目について、インラインおよび並列の
  // ドキュメントを表示するか
  "show_completion_documentation": true,
  // エディターのかっこを色分けするか。
  // （"rainbow brackets" とも呼ばれます）
  //
  // インデントレベルごとに使う色はテーマで定義されます（テーマキー: `accents`）。
  // テーマの上書き設定でカスタマイズできます。
  "colorize_brackets": false,
  // 補完メニューでスクロールバーをいつ表示するか。
  // この設定は 4 つの値を指定できます:
  //
  // 1. 重要な情報がある場合はスクロールバーを表示するか、
  //    システムの設定動作に従う
  //   "auto"
  // 2. システムの設定動作に合わせる:
  //    "system"
  // 3. 常にスクロールバーを表示する:
  //    "always"
  // 4. スクロールバーを表示しない:
  //    "never" (default)
  "completion_menu_scrollbar": "never",
  // 補完メニューの各項目で、LSP の項目種別（関数、メソッド、変数など）を
  // どのように表示するか。
  //
  // 1. 項目の種別を表示しない:
  //   "off" (default)
  // 2. 1 文字のバッジを表示し、アクティブな構文テーマに基づいて色を付ける:
  //   "symbol"
  "completion_menu_item_kind": "off",
  // 補完中でないときに Supertab アクションをどうするか。
  "supertab_fallback": "tab", // tab または indent
  // kill ring を同期する（emacs モード）
  "sync_kill_ring": "clipboard", // clipboard、primary または none
  // 行番号のスケール
  "line_number_scale": "default", // default、small、xsmall
  // かっこの内側にいるとき、エディターにメソッドのシグネチャを表示する。
  "auto_signature_help": false,
  // 補完後、またはかっこのペアを挿入した後に、シグネチャヘルプを表示するか。
  // `auto_signature_help` が有効な場合、この設定も有効として扱われます。
  "show_signature_help_after_edits": false,
  // バッファーの行頭にコードアクションボタンを表示するか。
  "inline_code_actions": true,
  // バッファー内でのドラッグ＆ドロップによるテキスト選択を許可するか。
  "drag_and_drop_selection": {
    // true のとき、バッファー内でのドラッグ＆ドロップによるテキスト選択を有効にします。
    "enabled": true,
    // ドラッグ＆ドロップを許可するまでに必要な遅延（ミリ秒）。それより早い場合は新しいテキスト選択が作成されます。
    "delay": 300,
  },
  // 定義へ移動しても結果がないときの動作。
  //
  // 1. 何もしない: `none`
  // 2. 同じシンボルの参照を検索する: `find_all_references`（デフォルト）
  "go_to_definition_fallback": "find_all_references",
  // エディターに表示する診断を絞り込む基準のレベル。
  //
  // エディターの描画にのみ影響し、
  // 診断の取得やプロジェクト診断エディターの機能は妨げません。
  // タブでマークする、診断のエラー/警告を含むファイル。
  // 診断はファイルアイコンも有効な場合にのみ表示されます。
  // この設定はファイルアイコンが有効な場合にのみ機能し、次の 3 つの値を指定できます:
  //
  // スクロールバーに表示する診断インジケーター。指定した重大度以上のレベルのものが対象になります。
  // 指定可能な値:
  //  - "off" — 診断を許可しない
  //  - "error"
  //  - "warning"
  //  - "info"
  //  - "hint"
  //  - "all" — すべての診断を許可する（デフォルト）
  "diagnostics_max_severity": "all",
  // エディターに折り返しガイド（縦方向のルーラー）を表示するか。
  // true に設定すると、'soft_wrap' が 'preferred_line_length' の場合は
  // 'preferred_line_length' の値の位置にガイドが表示され、
  // 'wrap_guides' 設定で指定した追加のガイドも表示されます。
  "show_wrap_guides": true,
  // エディターで折り返しガイドを表示する文字数。
  "wrap_guides": [],
  // プライベートファイルで変数の値を表示しないようにする
  "redact_private_values": false,
  // マルチバッファーで抜粋を展開する既定の行数。
  "expand_excerpt_lines": 5,
  // マルチバッファーの抜粋に表示する既定のコンテキスト行数。
  "excerpt_context_lines": 2,
  // ファイルがプライベートかどうかを判定するために、ファイルパスと照合する glob。
  "private_files": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/secrets.yml"],
  // LSP サーバーの機能で定義された各
  // "trigger" シンボル入力の後に、追加の LSP クエリでコードを整形（および修正）するか。
  "use_on_type_format": true,
  // 開きかっこ、角かっこ、波かっこ、シングルクォート、
  // ダブルクォートを入力したときに、対応する閉じ文字を自動追加するか。
  // たとえば '(' を入力すると、Gram は正しい位置に閉じ ) を追加します。
  "use_autoclose": true,
  // 開きかっこ、角かっこ、波かっこ、シングルクォート、ダブルクォートを
  // 入力したときに、選択テキストを自動的に囲むか。
  // たとえばテキストを選択して '(' を入力すると、Gram はそのテキストを () で囲みます。
  "use_auto_surround": true,
  // 入力中にコンテキストに基づいてインデントを調整するか。
  "auto_indent": true,
  // 貼り付けた内容のインデントをコンテキストに基づいて調整するか。
  "auto_indent_on_paste": true,
  // エディターが自動閉じされた文字をどう扱うかを制御します。
  // `false`（デフォルト）に設定すると、閉じ文字のスキップと自動削除は
  // 自動挿入された文字に対してのみ行われます。
  // それ以外（`true`）の場合、閉じ文字は挿入方法に関係なく
  // 常にスキップされ、自動削除されます。
  "always_treat_brackets_as_autoclosed": false,
  // 現在の言語スコープで `editor::Rewrap` アクションを許可する場所を制御します。
  //
  // この設定は 3 つの値を指定できます:
  //
  // 1. コメント内でのみ再折り返しを許可する:
  //    "in_comments"
  // 2. 現在の選択範囲内でのみ再折り返しを許可する:
  //    "in_selections"
  // 3. どこでも再折り返しを許可する:
  //    "anywhere"
  //
  // `in_comments` 以外の値を使うと、再折り返しによって
  // 構文的に無効なコードが生成される可能性があります。どの動作を使うか
  // 選ぶ際は注意してください。
  //
  // 注: Vim モードでは再折り返しがすでにどこでも許可されているため、この設定は効果がありません。
  "allow_rewrap": "in_comments",
  // エディターでタブとスペースを表示するか。
  // この設定は 4 つの値を指定できます:
  //
  // 1. 選択テキストに対してのみタブとスペースを描画する（デフォルト）:
  //    "selection"
  // 2. タブやスペースを描画しない:
  //    "none"
  // 3. すべての不可視記号を描画する:
  //    "all"
  // 4. 境界にある空白のみ描画する:
  //    "boundary"
  // 5. 非空白文字の後の空白のみ描画する:
  //    "trailing"
  // 空白が境界にあると見なされるには、次のいずれかを満たす必要があります:
  // - タブである
  // - 端（先頭または末尾）に隣接している
  // - 空白（左または右）に隣接している
  "show_whitespaces": "trailing",
  // show_whitespaces が有効なときに空白を描画する可視文字。
  "whitespace_map": {
    "space": "•",
    "tab": "→",
  },
  // ツールバーに関する設定
  "toolbar": {
    // パンくずリストを表示するか。
    "breadcrumbs": true,
    // クイックアクションボタンを表示するか。
    "quick_actions": true,
    // エディターツールバーに「選択範囲」メニューを表示するか。
    "selections_menu": true,
    // エディターツールバーにコードアクションボタンを表示するか。
    "code_actions": false,
  },
  // ユーザーのタブ設定に基づいてウィンドウをまとめてタブ化できるようにするか（macOS のみ）。
  "use_system_window_tabs": false,
  // タイトルバーに関する設定
  "title_bar": {
    // タイトルバーを表示するか。
    "show": true,
    // タイトルバーのブランチ切り替えの横にブランチアイコンを表示するか。
    "show_branch_icon": true,
    // タイトルバーにブランチ名ボタンを表示するか。
    "show_branch_name": true,
    // タイトルバーにプロジェクトのホストと名前を表示するか。
    "show_project_items": true,
    // タイトルバーにオンボーディングのバナーを表示するか。
    "show_onboarding_banner": true,
    // タイトルバーにメニューを表示するか。
    "show_menus": false,
  },
  // スクロールバーに関する設定
  "scrollbar": {
    // エディターでスクロールバーをいつ表示するか。
    // この設定は 4 つの値を指定できます:
    //
    // 1. 重要な情報がある場合はスクロールバーを表示するか、
    //    システムの設定動作に従う（デフォルト）:
    //   "auto"
    // 2. システムの設定動作に合わせる:
    //    "system"
    // 3. 常にスクロールバーを表示する:
    //    "always"
    // 4. スクロールバーを表示しない:
    //    "never"
    "show": "auto",
    // スクロールバーにカーソル位置を表示するか。
    "cursors": true,
    // スクロールバーに git の差分インジケーターを表示するか。
    "git_diff": true,
    // スクロールバーにバッファー検索の結果を表示するか。
    "search_results": true,
    // スクロールバーに選択テキストの出現箇所を表示するか。
    "selected_text": true,
    // スクロールバーに選択シンボルの出現箇所を表示するか。
    "selected_symbol": true,
    // スクロールバーに表示する診断インジケーター:
    //  - "none" または false: 診断を表示しない
    //  - "error": エラーのみ表示する
    //  - "warning": エラーと警告のみ表示する
    //  - "information": エラー、警告、情報のみ表示する
    //  - "all" または true: すべての診断を表示する
    "diagnostics": "all",
    // 軸ごとにスクロールバーを強制的に有効または無効にする
    "axes": {
      // false のときは水平スクロールバーを強制的に無効にします。それ以外は他の設定に従います。
      "horizontal": true,
      // false のときは垂直スクロールバーを強制的に無効にします。それ以外は他の設定に従います。
      "vertical": true,
    },
  },
  // ミニマップに関する設定
  "minimap": {
    // エディターでミニマップをいつ表示するか。
    // この設定は 3 つの値を指定できます:
    // 1. エディターのスクロールバーが表示されている場合にミニマップを表示する:
    //    "auto"
    // 2. 常にミニマップを表示する:
    //    "always"
    // 3. ミニマップを表示しない:
    //    "never" (default)
    "show": "never",
    // エディター内でミニマップを表示する場所。
    // この設定は 2 つの値を指定できます:
    // 1. フォーカスされたエディターにのみミニマップを表示する:
    //    "active_editor" (default)
    // 2. 開いているすべてのエディターにミニマップを表示する:
    //    "all_editors"
    "display_in": "active_editor",
    // ミニマップのサム（つまみ）をいつ表示するか。
    // この設定は 2 つの値を指定できます:
    // 1. マウスがミニマップ上にある場合にサムを表示する:
    //    "hover"
    // 2. 常にサムを表示する:
    //    "always" (default)
    "thumb": "always",
    // ミニマップのサムの境界線の見た目。
    // この設定は 5 つの値を指定できます:
    // 1. サムの四辺すべてに境界線を表示する:
    //    "thumb_border": "full"
    // 2. サムの左辺以外のすべての辺に境界線を表示する:
    //    "thumb_border": "left_open" (default)
    // 3. サムの右辺以外のすべての辺に境界線を表示する:
    //    "thumb_border": "right_open"
    // 4. サムの左辺にのみ境界線を表示する:
    //    "thumb_border": "left_only"
    // 5. 境界線なしでサムを表示する:
    //    "thumb_border": "none"
    "thumb_border": "left_open",
    // ミニマップで現在行を強調表示する方法。
    // この設定は次の値を指定できます:
    //
    // 1. エディターの `current_line_highlight` 設定を継承する `null`（デフォルト）
    // 2. "line" または "all" でミニマップの現在行を強調表示する。
    // 3. "gutter" または "none" でミニマップの現在行を強調表示しない。
    "current_line_highlight": null,
    // ミニマップに表示する最大列数。
    "max_width_columns": 80,
  },
  // Linux で中クリック貼り付けを有効にする。
  "middle_click_paste": true,
  // マルチバッファーの抜粋（単一バッファーの一部）を
  // ダブルクリックしたときの動作。
  // 2 つの値を指定できます:
  //  1. 通常のバッファーとして振る舞い、単語全体を選択する（デフォルト）。
  //         "double_click_in_multibuffer": "select"
  //  2. クリックした抜粋を新しいバッファーとして新しいタブで開く。
  //         "double_click_in_multibuffer": "open",
  // "open" の場合、ダブルクリック時に `alt` を押すと通常の選択動作になります。
  "double_click_in_multibuffer": "select",
  "gutter": {
    // ガターに行番号を表示するか。
    "line_numbers": true,
    // ガターに実行ボタンを表示するか。
    "runnables": true,
    // ガターにブレークポイントを表示するか。
    "breakpoints": true,
    // ガターに折りたたみボタンを表示するか。
    "folds": true,
    // ガターで領域を確保する最小文字数。
    "min_line_number_digits": 4,
  },
  "indent_guides": {
    // エディターにインデントガイドを表示するか。
    "enabled": true,
    // インデントガイドの幅（ピクセル、1〜10）。
    "line_width": 1,
    // アクティブなインデントガイドの幅（ピクセル、1〜10）。
    "active_line_width": 1,
    // インデントガイドの色付け方法を指定します。
    // この設定は次の 3 つの値を指定できます:
    //
    // 1. "disabled"
    // 2. "fixed"
    // 3. "indent_aware"
    "coloring": "fixed",
    // インデントガイドの背景の色付け方法を指定します。
    // この設定は次の 2 つの値を指定できます:
    //
    // 1. "disabled"
    // 2. "indent_aware"
    "background_coloring": "disabled",
  },
  // エディターが最終行を超えてスクロールするか。
  "scroll_beyond_last_line": "one_page",
  // キーボードでスクロールするときにカーソルの上下に確保する行数
  "vertical_scroll_margin": 3,
  // 表示中のテキスト領域の端付近をクリックしたときにスクロールするか。
  "autoscroll_on_clicks": false,
  // マウスでスクロールするときに左右に確保する文字数
  "horizontal_scroll_margin": 5,
  // スクロール感度の倍率。この倍率はスクロール時の
  // 水平方向と垂直方向の両方の差分値に適用されます。
  "scroll_sensitivity": 1.0,
  // 高速スクロール用のスクロール感度の倍率。この倍率はスクロール時の
  // 水平方向と垂直方向の両方の差分値に適用されます。高速スクロールは
  // スクロール中に alt キーまたは option キーを押しているときに発生します。
  "fast_scroll_sensitivity": 4.0,
  "smooth_scroll": {
    // スムーズなイージング効果でスクロールをアニメーションするか。
    "enabled": false,
    // スクロールアニメーションの時間（ミリ秒）
    "duration": 160,
  },
  "sticky_scroll": {
    // スコープをエディターの上部に固定するか。
    "enabled": false,
  },
  // 相対行番号を表示する: "disabled"、"enabled" または "wrapped"
  "relative_line_numbers": "disabled",
  // 'search_wrap' が無効な場合、検索結果はファイルの末尾で折り返しません。
  "search_wrap": true,
  // 新しいプロジェクト検索とバッファー検索を開いたときに既定で有効にする検索オプション。
  "search": {
    // ステータスバーにプロジェクト検索ボタンを表示するか。
    "button": true,
    // 単語単位でのみ一致させるか。
    "whole_word": false,
    // 大文字と小文字を区別して一致させるか。
    "case_sensitive": false,
    // 検索結果に gitignore 対象のファイルを含めるか。
    "include_ignored": false,
    // 検索クエリを正規表現として解釈するか。
    "regex": false,
    // 移動時に各検索一致箇所へカーソルを中央揃えするか。
    "center_on_match": true,
  },
  // カーソル下のテキストに基づいて新しい検索のクエリをいつ埋めるか。
  // この設定は次の 3 つの値を指定できます:
  //
  // 1. 常にカーソル下の単語で検索クエリを埋める（デフォルト）。
  //    "always"
  // 2. テキストが選択されている場合にのみ検索クエリを埋める
  //    "selection"
  // 3. 検索クエリを埋めない
  //    "never"
  "seed_search_query_from_cursor": "always",
  // 有効にすると、クエリに基づいて検索の大文字小文字の区別を自動調整します。
  // クエリに大文字が含まれていれば大文字小文字を区別し、
  // 小文字のみなら区別しません。
  "use_smartcase_search": true,
  // インレイヒントに関する設定
  "inlay_hints": {
    // ヒントをオン/オフするグローバルスイッチ。既定ではオフです。
    "enabled": false,
    // 特定の種類のヒントをオン/オフします。すべて既定ではオンです。
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_value_hints": true,
    // null/None の LSP ヒント種別の値に対応します。
    "show_other_hints": true,
    // インレイヒントに背景を表示するか。
    //
    // `true` に設定すると、背景には現在のテーマの `hint.background` 色が使われます。
    "show_background": false,
    // バッファーの編集後、ヒントを要求するまでの待ち時間。
    // 0 に設定するとデバウンスが無効になります。
    "edit_debounce_ms": 700,
    // バッファーのスクロール後、ヒントを要求するまでの待ち時間。
    // 0 に設定するとデバウンスが無効になります。
    "scroll_debounce_ms": 50,
    // 押すとインレイヒントの表示を切り替える修飾キーのセット。
    // セットが空の場合、または指定したすべての修飾キーが押されていない場合、インレイヒントは切り替わりません。
    "toggle_on_modifiers_press": {
      "control": false,
      "shift": false,
      "alt": false,
      "platform": false,
      "function": false,
    },
  },
  // ドックのサイズを変更したときに、ドック内のすべてのパネルのサイズを変更するか。
  // "left"、"right"、"bottom" を組み合わせて指定できます。
  "resize_all_panels_in_dock": ["left"],
  "project_panel": {
    // ステータスバーにプロジェクトパネルのボタンを表示するか
    "button": true,
    // プロジェクトパネルで gitignore の項目を非表示にするか。
    "hide_gitignore": false,
    // プロジェクトパネルの既定の幅。
    "default_width": 240,
    // プロジェクトパネルをドックする位置。'left' または 'right' を指定できます。
    "dock": "left",
    // プロジェクトパネルのワークツリー項目間の間隔。'comfortable'、'standard'、'tight' を指定できます。
    "entry_spacing": "standard",
    // プロジェクトパネルにファイルアイコンを表示するか。
    "file_icons": true,
    // プロジェクトパネルのディレクトリにフォルダーアイコンまたはシェブロンを表示するか。
    "folder_icons": true,
    // プロジェクトパネルに git のステータスを表示するか。
    "git_status": true,
    // ネストした項目のインデント量。
    "indent_size": 20,
    // 対応するプロジェクトの項目がアクティブになったときに、
    // プロジェクトパネルで自動的に表示するか。
    // gitignore の項目は自動表示されません。
    "auto_reveal_entries": true,
    // 起動時にプロジェクトパネルを開くか。
    "starts_open": true,
    // ディレクトリ内にサブディレクトリが 1 つだけある場合に、
    // ディレクトリを自動的に折りたたみ、コンパクトな表示（例: "a/b/c"）にするか。
    "auto_fold_dirs": true,
    // スクロールバーに関する設定
    "scrollbar": {
      // プロジェクトパネルでスクロールバーをいつ表示するか。
      // この設定は 5 つの値を指定できます:
      //
      // 1. null（デフォルト）: エディターの設定を継承する
      // 2. 重要な情報がある場合はスクロールバーを表示するか、
      //    システムの設定動作に従う（デフォルト）:
      //   "auto"
      // 3. システムの設定動作に合わせる:
      //    "system"
      // 4. 常にスクロールバーを表示する:
      //    "always"
      // 5. スクロールバーを表示しない:
      //    "never"
      "show": null,
    },
    // プロジェクトパネルでマークする、診断のエラー/警告を含むファイル。
    // この設定は次の 3 つの値を指定できます:
    //
    // 1. ファイルをマークしない:
    //    "off"
    // 2. エラーのあるファイルのみマークする:
    //    "errors"
    // 3. エラーと警告のあるファイルをマークする:
    //    "all"
    "show_diagnostics": "all",
    // 親ディレクトリをプロジェクトパネルの上部に固定するか。
    "sticky_scroll": true,
    // プロジェクトパネルのインデントガイドに関する設定。
    "indent_guides": {
      // プロジェクトパネルでインデントガイドをいつ表示するか。
      // この設定は 2 つの値を指定できます:
      //
      // 1. 常にインデントガイドを表示する:
      //    "always"
      // 2. インデントガイドを表示しない:
      //    "never"
      "show": "always",
    },
    // プロジェクトパネルの項目の並び順。
    // この設定は 4 つの値を指定できます:
    //
    // 1. ディレクトリを先に、次にファイルを表示する:
    //    "directories_first"
    // 2. ディレクトリ、mod.rs ファイル、それ以外の順に表示する:
    //    "smart_sort"
    // 3. ディレクトリとファイルを混在させる:
    //    "mixed"
    // 4. ファイルを先に、次にディレクトリを表示する:
    //    "files_first"
    "sort_mode": "directories_first",
    // プロジェクトパネルでのドラッグ＆ドロップ操作を有効にするか。
    "drag_and_drop": true,
    // ウィンドウでフォルダーが 1 つだけ開かれているときにルート項目を非表示にするか。
    "hide_root": false,
    // プロジェクトパネルで隠し項目を非表示にするか。
    "hide_hidden": false,
    // ファイルを自動的に開くための設定。
    "auto_open": {
      // 新しく作成したファイルをエディターで自動的に開くか。
      "on_create": true,
      // 貼り付けまたは複製の後にファイルを自動的に開くか。
      "on_paste": true,
      // 外部からドロップされたファイルを自動的に開くか。
      "on_drop": true,
      // 自動的に開いたファイルにフォーカスするか。
      "should_focus": true,
    },
  },
  "outline_panel": {
    // ステータスバーにアウトラインパネルのボタンを表示するか
    "button": true,
    // アウトラインパネルの既定の幅。
    "default_width": 300,
    // アウトラインパネルをドックする位置。'left' または 'right' を指定できます。
    "dock": "left",
    // アウトラインパネルにファイルアイコンを表示するか。
    "file_icons": true,
    // アウトラインパネルのディレクトリにフォルダーアイコンまたはシェブロンを表示するか。
    "folder_icons": true,
    // アウトラインパネルに git のステータスを表示するか。
    "git_status": true,
    // ネストした項目のインデント量。
    "indent_size": 20,
    // 対応するアウトラインの項目がアクティブになったときに、
    // アウトラインパネルで自動的に表示するか。
    // gitignore の項目は自動表示されません。
    "auto_reveal_entries": true,
    // ディレクトリ内にディレクトリが 1 つだけある場合に、
    // ディレクトリを自動的に折りたたむか。
    "auto_fold_dirs": true,
    // アウトラインパネルのインデントガイドに関する設定。
    "indent_guides": {
      // アウトラインパネルでインデントガイドをいつ表示するか。
      // この設定は 2 つの値を指定できます:
      //
      // 1. 常にインデントガイドを表示する:
      //    "always"
      // 2. インデントガイドを表示しない:
      //    "never"
      "show": "always",
    },
    // スクロールバーに関する設定
    "scrollbar": {
      // プロジェクトパネルでスクロールバーをいつ表示するか。
      // この設定は 5 つの値を指定できます:
      //
      // 1. null（デフォルト）: エディターの設定を継承する
      // 2. 重要な情報がある場合はスクロールバーを表示するか、
      //    システムの設定動作に従う（デフォルト）:
      //   "auto"
      // 3. システムの設定動作に合わせる:
      //    "system"
      // 4. 常にスクロールバーを表示する:
      //    "always"
      // 5. スクロールバーを表示しない:
      //    "never"
      "show": null,
    },
    // 現在のファイルでアウトライン項目を展開する既定の深さ。
    // 0 に設定すると子を持つすべての項目を折りたたみ、1 以上に設定するとその深さ以降の項目を折りたたみます。
    "expand_outlines_with_depth": 100,
  },
  "git_panel": {
    // ステータスバーに git パネルのボタンを表示するか。
    "button": true,
    // git パネルをドックする位置。'left' または 'right' を指定できます。
    "dock": "left",
    // git パネルの既定の幅。
    "default_width": 360,
    // パネル内の git ステータスインジケーターのスタイル。
    //
    // 選択肢: label_color、icon
    // デフォルト: icon
    "status_style": "icon",
    // `init.defaultBranch` が設定されていない場合に使うブランチ名
    //
    // デフォルト: main
    "fallback_branch_name": "main",
    // パネルの項目をパス順に並べるか、ステータス順（デフォルト）に並べるか。
    //
    // デフォルト: false
    "sort_by_path": false,
    // diff パネルで未追跡ファイルを折りたたむか。
    //
    // デフォルト: false
    "collapse_untracked_diff": false,
    /// パネル内の項目をツリー表示にするかフラット表示にするか
    ///
    /// デフォルト: false
    "tree_view": false,
    // 各項目の追加行数と削除行数、およびリポジトリ全体の
    // 合計を表示するか。
    //
    // デフォルト: true
    "diff_stats": true,
    "scrollbar": {
      // git パネルでスクロールバーをいつ表示するか。
      //
      // 選択肢: always、auto、never、system
      // デフォルト: エディターのスクロールバー設定を継承
      // "show": null
    },
  },
  // 言語サーバーを使ってコードインテリジェンスを提供するか。
  "enable_language_server": true,
  // 言語サーバーが対応していれば、関連する範囲のリンク編集を行うか。
  // たとえば開始 <html> タグを編集すると、終了 </html> タグの内容も編集されます。
  "linked_edits": true,
  // すべての言語で使用する（または無効にする）言語サーバーのリスト。
  //
  // 通常は言語ごとにカスタマイズします。
  "language_servers": ["..."],

  // 編集したバッファーをいつ自動保存するか。この設定は
  // 4 つの値を指定できます。
  //
  // 1. 自動保存しない:
  //     "autosave": "off",
  // 2. Gram ウィンドウからフォーカスが外れたときに保存する:
  //     "autosave": "on_window_change",
  // 3. 特定のバッファーからフォーカスが外れたときに保存する:
  //     "autosave": "on_focus_change",
  // 4. 一定時間アイドル状態になったときに保存する:
  //     "autosave": { "after_delay": {"milliseconds": 500} },
  "autosave": "off",
  // ペインあたりの最大タブ数。未設定なら無制限です。
  "max_tabs": null,
  // エディターのタブバーに関する設定。
  "tab_bar": {
    // エディターにタブバーを表示するかどうか
    "show": true,
    // ナビゲーション履歴のボタンを表示するかどうか。
    "show_nav_history_buttons": true,
    // タブバーのボタンをいつ表示するか。
    "show_tab_bar_buttons": "on_pane_focus",
    // ピン留めしたタブを別の行に表示するかどうか。
    // 有効にすると、ピン留めしたタブは上の行、ピン留めしていないタブは下の行に表示されます。
    // 無効にすると、すべてのタブが 1 行に表示されます（デフォルトの動作）。
    "show_pinned_tabs_in_separate_row": false,
    // タブバーがあふれたときに、横スクロールの代わりに
    // タブを追加の行に折り返すか。
    "wrap_tabs": false,
  },
  // エディターのタブに関する設定
  "tabs": {
    // エディターのタブに git ステータスの色を表示する。
    "git_status": false,
    // エディターのタブの閉じるボタンの位置。
    // 次のいずれか: ["right", "left"]
    "close_position": "right",
    // タブにファイルアイコンを表示するか。
    "file_icons": false,
    // タブの閉じるボタンの表示動作を制御します。
    //
    // 1. タブにホバーしたときだけ表示する。（デフォルト）
    //     "hover"
    // 2. 常に表示する。
    //     "always"
    // 3. ホバーしても表示しない。
    //     "hidden"
    "show_close_button": "hover",
    // 現在のタブを閉じた後の動作。
    //
    // 1. 以前に開いていたタブをアクティブにする（デフォルト）
    //     "history"
    // 2. 右隣のタブがあればアクティブにする
    //     "neighbour"
    // 3. 左隣のタブがあればアクティブにする
    //     "left_neighbour"
    "activate_on_close": "history",
    // タブでマークする、診断のエラー/警告を含むファイル。
    // 診断はファイルアイコンも有効な場合にのみ表示されます。
    // この設定は次の 3 つの値を指定できます:
    //
    // 1. ファイルをマークしない:
    //    "off"
    // 2. エラーのあるファイルのみマークする:
    //    "errors"
    // 3. エラーと警告のあるファイルをマークする:
    //    "all"
    "show_diagnostics": "off",
    // 未保存の変更インジケーターを表示するかどうか。
    "show_unsaved_indicator": true,
  },
  // プレビュータブに関する設定。
  "preview_tabs": {
    // プレビュータブを有効にするか。
    // プレビュータブを使うとファイルをプレビューモードで開け、別のプレビュータブを
    // 開くと自動的に閉じられます。
    // ワークスペースを散らかさずにファイルを素早く確認したいときに便利です。
    "enabled": true,
    // プロジェクトパネルからシングルクリックで開いたときに、プレビューモードで開くか。
    "enable_preview_from_project_panel": true,
    // ファイルファインダーから選択したときに、プレビューモードで開くか。
    "enable_preview_from_file_finder": false,
    // マルチバッファーから開いたときに、プレビューモードで開くか。
    "enable_preview_from_multibuffer": true,
    // コードナビゲーションでマルチバッファーを開くときに、プレビューモードで開くか。
    "enable_preview_multibuffer_from_code_navigation": false,
    // コードナビゲーションで単一ファイルを開くときに、プレビューモードで開くか。
    "enable_preview_file_from_code_navigation": true,
    // コードナビゲーションで別の場所へ移動したときに、タブをプレビューモードのままにするか。
    // `enable_preview_file_from_code_navigation` または `enable_preview_multibuffer_from_code_navigation` も true の場合、新しいタブが既存のタブを置き換えることがあります。
    "enable_keep_preview_on_code_navigation": false,
  },
  // ファイルファインダーに関する設定。
  "file_finder": {
    // ファイルファインダーにファイルアイコンを表示するか。
    "file_icons": true,
    // 利用可能なウィンドウ幅に対してファイルファインダーが占める割合を指定します。
    // 幅の値は 5 つあります:
    //
    // 1. small: 実質的に固定幅です。
    //    "modal_max_width": "small"
    // 2. medium:
    //    "modal_max_width": "medium"
    // 3. large:
    //    "modal_max_width": "large"
    // 4. xlarge:
    //    "modal_max_width": "xlarge"
    // 5. full: ビューポート幅全体を占めるため、水平方向のパディングがなくなります。
    //    "modal_max_width": "full"
    //
    // デフォルト: small
    "modal_max_width": "small",
    // ファイルファインダーが検索結果内のアクティブなファイルへのフォーカスをスキップするかどうかを指定します。
    // 値は 2 つあります:
    //
    // 1. true: ファイル検索時に、現在アクティブなファイルが最初の結果として現れた場合、
    // 自動フォーカスはそれを飛ばして 2 番目の結果にフォーカスします。
    //    "skip_focus_for_active_in_search": true
    //
    // 2. false: ファイル検索時に、最初の結果が常にフォーカスを受け取ります。
    // それが現在アクティブなファイルであっても同様です。
    //    "skip_focus_for_active_in_search": false
    //
    // デフォルト: true
    "skip_focus_for_active_in_search": true,
    // ファイルファインダーに git のステータスを表示するか。
    "git_status": true,
    // 検索時に gitignore 対象のファイルを使うか。
    // 使用されるのは Gram がインデックス済みのファイルのみで、gitignore 対象のすべてのファイルとは限りません。
    //
    // 3 つの値を指定できます:
    //   * "all": gitignore 対象のすべてのファイルを使う
    //   * "indexed": Gram がインデックス済みのファイルのみを使う
    //   * "smart": gitignore 対象のワークツリーから呼ばれた場合に、賢く無視対象を検索する
    "include_ignored": "smart",
  },
  // バッファーの各行から末尾の空白を削除してから
  // 保存するかどうか。
  "remove_trailing_whitespace_on_save": true,
  // 前の行もコメントである場合に、新しい行をコメントで開始するか。
  "extend_comment_on_newline": true,
  // ファイル末尾の空白のみの行を削除し、
  // 末尾に改行が 1 つだけあるようにします。
  "ensure_final_newline_on_save": true,
  // 保存前にバッファーの整形を行うかどうか: [on, off]
  // 遅延付きの自動保存が有効な場合、format_on_save は無視される点に注意してください
  "format_on_save": "on",
  // バッファーの整形方法。この設定は複数の値を指定できます:
  //
  // 1. デフォルト。Gram の Prettier 連携（該当する場合）でファイルを整形し、
  //    できない場合は言語サーバーによる整形にフォールバックします:
  //     "formatter": "auto"
  // 2. 現在の言語サーバーでコードを整形する:
  //     "formatter": "language_server"
  // 3. 特定の言語サーバーでコードを整形する:
  //     "formatter": {"language_server": {"name": "ruff"}}
  // 4. 外部コマンドでコードを整形する:
  //     "formatter": {
  //       "external": {
  //         "command": "prettier",
  //         "arguments": ["--stdin-filepath", "{buffer_path}"]
  //       }
  //     }
  // 5. Gram の Prettier 連携でコードを整形する:
  //     "formatter": "prettier"
  // 6. コードアクションでコードを整形する
  //     "formatter": {"code_action": "source.fixAll.eslint"}
  // 7. 上記の任意の整形手順を順に適用する配列
  //     "formatter": [{"code_action": "source.fixAll.eslint"}, "prettier"]
  "formatter": "auto",
  // 長い行のソフト折り返し方法。
  // 指定可能な値:
  //
  // 1. 極端に長い行が出ない限り、基本的に 1 行を優先する。
  //      "soft_wrap": "none",
  //      "soft_wrap": "prefer_line", // (deprecated, same as "none")
  // 2. エディターからあふれた行をソフト折り返しする。
  //      "soft_wrap": "editor_width",
  // 3. 優先行長で行をソフト折り返しする。
  //      "soft_wrap": "preferred_line_length",
  // 4. 優先行長またはエディター幅の小さい方で行をソフト折り返しする。
  //      "soft_wrap": "bounded",
  "soft_wrap": "none",
  // ソフト折り返しが有効なバッファーで、行をソフト折り返しする
  // 列位置。
  "preferred_line_length": 80,
  // インデントに複数のスペースではなくタブ文字を
  // 使うか。
  "hard_tabs": false,
  // タブが占める列数。
  "tab_size": 4,
  // すべての言語で既定で優先するデバッガー。
  "debuggers": [],
  // エディターで単語単位の差分強調表示を有効にするか。
  //
  // 有効にすると、変更された行内の変更された単語が強調表示され、
  // 何が変わったかを正確に示します。
  //
  // デフォルト: true
  "word_diff_enabled": true,
  // エディターで LSP `textDocument/documentColor` の色を描画する方法。
  //
  // 指定可能な値:
  //
  // 1. ドキュメントの色を問い合わせも描画もしない。
  //      "lsp_document_colors": "none",
  // 2. 色テキストの近くにインレイヒントとしてドキュメントの色を描画する（デフォルト）。
  //      "lsp_document_colors": "inlay",
  // 3. 色テキストの周囲に境界線を描く。
  //      "lsp_document_colors": "border",
  // 4. 色テキストの背後に背景を描く。
  //      "lsp_document_colors": "background",
  "lsp_document_colors": "inlay",
  // 診断の設定。
  "diagnostics": {
    // ステータスバーにプロジェクト診断のボタンを表示するか。
    "button": true,
    // 既定で警告を表示するかどうか。
    "include_warnings": true,
    // Gram で LSP のプル型診断の仕組みを使うための設定。
    "lsp_pull_diagnostics": {
      // 診断をプルするかどうか。
      "enabled": true,
      // 言語サーバーから診断をプルするまでの最小待ち時間。
      // 0 にするとデバウンスが無効になります。
      "debounce_ms": 50,
    },
    // インライン診断の設定
    "inline": {
      // 診断をインラインで表示するかどうか
      "enabled": false,
      // 最後の診断更新後にインライン診断を表示するまでの
      // 遅延（ミリ秒）。
      "update_debounce_ms": 150,
      // ソース行の末尾とインライン診断の開始位置の間の
      // パディング量（em 幅単位）。
      "padding": 4,
      // インライン診断を表示する最小列。この設定は
      // インライン診断を特定の列に水平に揃えるために使えます。
      // この値より長い行では、診断はさらに右へ押し出されます。
      "min_column": 0,
      // インラインで表示する診断の最小重大度。
      // `null` の場合はエディターの診断の最大重大度設定を継承します。
      "max_severity": null,
    },
  },
  // Gram が完全に除外するファイルまたは glob。ファイルスキャン、ファイル検索では
  // スキップされ、プロジェクトのファイルツリーにも表示されません。`file_scan_inclusions` より優先されます。
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  // git で無視されていても Gram が含めるファイルまたは glob。git で追跡されていないが
  // プロジェクトにとって重要なファイルに便利です。
  // 範囲が広すぎる glob は Gram のファイルスキャンを遅くする可能性があります。`file_scan_exclusions` は
  // この包含設定より優先されます。
  "file_scan_inclusions": [".env*"],
  // "hidden" と見なすファイルに一致する glob。これらのファイルは
  // "hide_hidden" 設定を切り替えることでプロジェクトパネルから非表示にできます。
  "hidden_files": ["**/.*"],
  /// ワークツリーの変更をプラットフォームネイティブのファイル監視（inotify や FSEvents など）の代わりにポーリングで監視するには `poll` に設定します。
  /// ポーリングは効率が劣りますが、
  /// ネットワークマウントなど一部のファイルシステムではうまく機能することがあります。
  "file_watcher": {
    /// ワークツリー内のファイル変更を検出する方法を設定します。
    ///
    /// - "native": プラットフォームネイティブのファイル監視を使う
    /// - "poll": ポーリングベースのファイル監視を使う
    ///
    /// デフォルト: "native"
    "mode": null,
    /// ポーリングモードのポーリング間隔（ミリ秒）。
    ///
    /// 範囲: 500〜30000 ms
    /// デフォルト: 2000 ms
    "poll_interval_ms": null,
  },
  // git ガターの動作設定。
  "git": {
    // 既定で diff を並べて表示する。
    "split_diff": false,
    // git ガターを表示するかどうかを制御します。2 つの値を指定できます:
    // 1. ガターを表示する
    //      "git_gutter": "tracked_files"
    // 2. ガターを非表示にする
    //      "git_gutter": "hide"
    "git_gutter": "tracked_files",
    /// 変更が git ガターに反映されるまでのデバウンスしきい値（ミリ秒）を設定します。
    ///
    /// デフォルト: 0
    "gutter_debounce": 0,
    // 現在フォーカスしている行に、git blame の情報を
    // インラインで表示するかどうかを制御します。
    "inline_blame": {
      "enabled": true,
      // インライン blame の情報を表示するまでの遅延を設定します。
      // 遅延はカーソルが移動するたびにリセットされます。
      "delay_ms": 0,
      // ソース行の末尾とインライン blame の開始位置の間の
      // パディング量（em 幅単位）。
      "padding": 7,
      // 同じ行に git のコミットサマリーを表示するかどうか。
      "show_commit_summary": false,
      // インライン blame の情報を表示する最小列番号
      "min_column": 0,
    },
    "blame": {
      "show_avatar": true,
    },
    // ブランチピッカーに表示する情報を制御します。
    "branch_picker": {
      "show_author_name": true,
    },
    // エディターで git のハンクを視覚的に表示する方法。
    // この設定は 2 つの値を指定できます:
    //
    // 1. 未ステージのハンクを塗りつぶし、ステージ済みのハンクを枠線で表示する:
    //    "hunk_style": "staged_hollow"
    // 2. 未ステージのハンクを枠線で、ステージ済みのハンクを塗りつぶしで表示する:
    //    "hunk_style": "unstaged_hollow"
    "hunk_style": "staged_hollow",
    // git ビューで名前とパスのどちらを先に表示するか。
    // "path_style": "file_name_first" or "file_path_first"
    "path_style": "file_name_first",
  },
  // カスタム Git ホスティングプロバイダーのリスト。
  "git_hosting_providers": [
    // {
    //   "provider": "github",
    //   "name": "BigCorp GitHub",
    //   "base_url": "https://code.big-corp.com"
    // }
  ],
  // direnv の設定をどのように読み込むか。2 つの値を指定できます:
  // 1. `direnv export json` を使って direnv の設定を直接読み込む。
  //      "load_direnv": "direct"
  // 2. シェルフック経由で direnv の設定を読み込む。POSIX シェルと fish で動作します。
  //      "load_direnv": "shell_hook"
  // 3. direnv の設定をまったく読み込まない。
  //      "load_direnv": "disabled"
  "load_direnv": "direct",
  // ジャーナリング固有の設定
  "journal": {
    // ジャーナルのエントリを保存するディレクトリのパス
    "path": "~",
    // 時刻をどの形式で表示するか
    // 2 つの値を指定できます:
    // 1. hour12
    // 2. hour24
    "hour_format": "hour24",
  },
  // ステータスバーに関する設定。
  "status_bar": {
    // ステータスバーを表示するか。
    "show": true,
    // ステータスバーにアクティブなファイルを表示するか。
    "active_file": true,
    // ステータスバーにアクティブな言語のボタンを表示するか。
    "active_language_button": true,
    // ステータスバーにカーソル位置のボタンを表示するか。
    "cursor_position_button": true,
    // ステータスバーにアクティブな改行コードのボタンを表示するか。
    "line_endings_button": false,
    // ステータスバーにアクティブなエンコーディングをいつ表示するかを制御します。
    "active_encoding_button": "non_utf8",
    // ステータスバーをウィンドウの上部または下部に表示します。
    "position": "bottom",
    // ステータスバーのアイコンサイズ。"default" または "large"。
    "icon_size": "default",
  },
  // ターミナル固有の設定
  "terminal": {
    // ターミナルを開くときに使うシェル。3 つの値を指定できます:
    // 1. /etc/passwd のシステム既定のターミナル設定を使う
    //      "shell": "system"
    // 2. プログラムを指定する:
    //      "shell": {
    //        "program": "sh"
    //      }
    // 3. 引数付きのプログラムを指定する:
    //     "shell": {
    //         "with_arguments": {
    //           "program": "/bin/bash",
    //           "args": ["--login"]
    //         }
    //     }
    "shell": "system",
    // ターミナルパネルをドックする位置。`left`、`right`、`bottom` を指定できます。
    "dock": "bottom",
    // ターミナルを左右にドックしたときの既定の幅。
    "default_width": 640,
    // ターミナルを下部にドックしたときの既定の高さ。
    "default_height": 320,
    // ターミナルを起動するときに使う作業ディレクトリ。
    // 4 つの値を指定できます:
    // 1. 現在のファイルのプロジェクトディレクトリを使う。失敗した場合は
    //    最初のプロジェクトディレクトリの方式にフォールバックする
    //      "working_directory": "current_project_directory"
    // 2. このワークスペースの最初のプロジェクトのディレクトリを使う
    //      "working_directory": "first_project_directory"
    // 3. 常にこのプラットフォームのホームディレクトリを使う（見つかる場合）
    //     "working_directory": "always_home"
    // 4. 常に特定のディレクトリを使う。この値はシェルで展開されます。
    // このパスが有効なディレクトリでない場合、ターミナルは
    // このプラットフォームのホームディレクトリを使います（見つかる場合）
    //      "working_directory": {
    //        "always": {
    //          "directory": "~/gram/projects/"
    //        }
    //      }
    "working_directory": "current_project_directory",
    // ターミナルのカーソル点滅動作を設定します。
    // 3 つの値を指定できます:
    //  1. ターミナルのモードに関係なく、カーソルを点滅させない
    //         "blinking": "off",
    //  2. カーソル点滅の既定をオフにし、ターミナルからの設定を
    //     許可する
    //         "blinking": "terminal_controlled",
    //  3. ターミナルのモードに関係なく、常にカーソルを点滅させる
    //         "blinking": "on",
    "blinking": "terminal_controlled",
    // ターミナルの既定のカーソル形状。
    //  1. 後続の文字を囲むブロック
    //     "block"
    //  2. 縦棒
    //     "bar"
    //  3. 後続の文字の下に沿う下線
    //     "underline"
    //  4. 後続の文字の周囲に描く枠
    //     "hollow"
    //
    // デフォルト: "block"
    "cursor_shape": "block",
    // Alternate Scroll モード（コード: ?1007）を既定で有効にするか設定します。
    // Alternate Scroll モードは、代替スクリーン（vim や less などの
    // アプリケーションを実行しているときなど）で、マウスのスクロールイベントを
    // 上下キー押下に変換します。ターミナルからこのモードの設定/解除は可能です。
    // 2 つの値を指定できます:
    //  1. Alternate Scroll モードの既定をオンにする
    //         "alternate_scroll": "on",
    //  2. Alternate Scroll モードの既定をオフにする
    //         "alternate_scroll": "off",
    "alternate_scroll": "on",
    // Option キーをメタキーとして動作させるか設定します。
    // 2 つの値を指定できます:
    //  1. プラットフォームの既定の Option キー処理に任せる。macOS では
    //     特定の Unicode 文字を生成することを意味します
    //         "option_as_meta": false,
    //  2. Option キーを 'meta' キーとして動作させる（例: emacs 用）
    //         "option_as_meta": true,
    "option_as_meta": false,
    // ターミナルでテキストを選択したときに、自動的に
    // システムクリップボードへコピーするかどうか。
    "copy_on_select": false,
    // クリップボードへコピーした後もテキスト選択を保持するか。
    "keep_selection_on_copy": true,
    // ステータスバーにターミナルボタンを表示するか
    "button": true,
    // ここに追加したキーと値のペアは、ターミナルの環境変数に
    // 追加されます。複数の値は `:` で区切ります。
    "env": {
      // "KEY": "value1:value2"
    },
    // ターミナルの行の高さを設定します。
    // 3 つの値を指定できます:
    //  1. 読みやすい行の高さ 1.618 を使用する
    //         "line_height": "comfortable"
    //  2. 標準の行の高さ 1.3 を使用する。このオプションは TUI、
    //      特に罫線素片を使う場合に便利です
    //         "line_height": "standard",
    //  3. カスタムの行の高さを使用する。
    //         "line_height": {
    //           "custom": 2
    //         },
    "line_height": "standard",
    // ターミナルの作業ディレクトリ（working_directory 設定で解決）に python の
    // 仮想環境が見つかった場合、それを有効化します。
    // この動作を無効にするには "off" に設定します。
    "detect_venv": {
      "on": {
        // 仮想環境を検索する既定のディレクトリ（現在の作業ディレクトリからの
        // 相対パス）。プロジェクトの設定で上書きすることを
        // 推奨します（グローバル設定ではなく）。
        "directories": [".env", "env", ".venv", "venv"],
        // `csh`、`fish`、`nushell`、`power_shell` も指定できます
        "activate_script": "default",
        // Conda 環境を有効化するときに使う優先 Conda マネージャー。
        // 値: "auto"、"conda"、"mamba"、"micromamba"
        // デフォルト: "auto"
        "conda_manager": "auto",
      },
    },
    "toolbar": {
      // ターミナルのタイトルをツールバーのパンくずリストに表示するか。
      // ターミナルのタイトルが空でない場合にのみ表示されます。
      //
      // ターミナルで実行しているシェルがタイトルを出力するように設定されている必要があります。
      // Example: `echo -e "\e]2;New Title\007";`
      "breadcrumbs": false,
    },
    // スクロールバーに関する設定
    "scrollbar": {
      // ターミナルでスクロールバーをいつ表示するか。
      // この設定は 5 つの値を指定できます:
      //
      // 1. null（デフォルト）: エディターの設定を継承する
      // 2. 重要な情報がある場合はスクロールバーを表示するか、
      //    システムの設定動作に従う（デフォルト）:
      //   "auto"
      // 3. システムの設定動作に合わせる:
      //    "system"
      // 4. 常にスクロールバーを表示する:
      //    "always"
      // 5. スクロールバーを表示しない:
      //    "never"
      "show": null,
    },
    // ターミナルのフォントサイズを設定します。このオプションを指定しない場合、
    // ターミナルはバッファーのフォントサイズに合わせて表示されます。
    // "font_size": 15,
    // ターミナルのフォントファミリーを設定します。このオプションを指定しない場合、
    // ターミナルはバッファーのフォントファミリーに合わせて表示されます。
    // "font_family": ".GramMono",
    // ターミナルの代替フォントを設定します。このオプションを指定しない場合、
    // ターミナルはバッファーの代替フォントに合わせて表示されます。
    // これはプラットフォームの既定の代替フォントとマージされます
    // "font_fallbacks": ["FiraCode Nerd Fonts"],
    // エディターフォントの太さ。100〜900 の標準 CSS 単位で指定します。
    "font_weight": 400,
    // ターミナルのスクロールバックバッファーの最大行数を設定します。
    // デフォルト: 10_000、最大: 100_000（それより大きい値は 100_000 として扱われます）、0 でスクロールを無効にします。
    // 既存のターミナルは再作成されるまでこの変更を反映しません。
    "max_scroll_history_lines": 10000,
    // ターミナルのスクロール速度の倍率。
    "scroll_multiplier": 1.0,
    // 前景色と背景色の間の最小 APCA 知覚コントラスト。
    // APCA（Accessible Perceptual Contrast Algorithm）は WCAG 2.x より正確で、
    // 特にダークモードに適しています。値の範囲は 0〜106 です。
    //
    // APCA Readability Criterion (ARC) の Bronze Simple Mode に基づきます:
    // https://readtech.org/ARC/tests/bronze-simple-mode/
    // - 0: コントラスト調整なし
    // - 45: 大きな流し読みテキストの最小値 (36px 以上)
    // - 60: その他のコンテンツテキストの最小値
    // - 75: 本文テキストの最小値
    // - 90: 本文テキストの推奨値
    //
    // ほとんどのターミナルテーマの APCA 値は 40〜70 です。
    // 45 にすると、カラフルなテーマを維持しつつ可読性を確保できます。
    "minimum_contrast": 45,
    // ハイパーリンク移動用のパスを識別する正規表現。任意の名前付きキャプチャ
    // グループ `path`、`line`、`column`、`link` に対応します。これらがどれもない場合、一致全体が
    // ハイパーリンクの対象になります。`path` がある場合はそれが対象となり、`line` と
    // `column` があればそれらも含まれます。`link` はターミナル内のどのテキストを
    // ハイパーリンクの一部にするかのカスタマイズに使えます。`link` がない場合は一致全体のテキストが使われます。`line` と
    // `column` がない場合は、組み込みの行・列サフィックス処理
    // が使われ、`line:column` と `(line,column)` の形式を解析します。既定値は Python の
    // 診断や一般的なパス、行、列の構文を扱います。拡張または置き換えにより、
    // 特定のシナリオに対応できます。たとえば、rust の出力でスペースを含む
    // パスのハイパーリンクを有効にするには、
    //
    // [
    //   "\\s+(-->|:::|at) (?<link>(?<path>.+?))(:$|$)",
    //   "\\s+(Compiling|Checking|Documenting) [^(]+\\((?<link>(?<path>.+))\\)"
    // ],
    //
    // と指定できます。処理は一致した最初の正規表現で停止します。
    // カーソルがハイパーリンクされたテキスト上にない場合はリンクが生成されません。最高の
    // パフォーマンスを得るには、正規表現を出現頻度の高い順に並べることを推奨します。
    // 可読性とドキュメント化のため、各正規表現は文字列の配列にでき、それらは
    // ターミナルのパスハイパーリンク検出用の 1 つの複数行正規表現に結合されます。
    "path_hyperlink_regexes": [
      // Python 形式の診断
      "File \"(?<path>[^\"]+)\", line (?<line>[0-9]+)",
      // 一般的なパス構文。行、列、説明、末尾の句読点、
      // または前後の記号や引用符は任意です
      [
        "(?x)",
        "(?<path>",
        "    (",
        "        # multi-char path: first char (not opening delimiter or space)",
        "        [^({\\[<\"'`\\ ]",
        "        # middle chars: non-space, and colon/paren only if not followed by digit/paren/space",
        "        ([^\\ :(]|[:(][^0-9()\\ ])*",
        "        # last char: not closing delimiter or colon",
        "        [^()}\\]>\"'`.,;:\\ ]",
        "    |",
        "        # single-char path: not delimiter, punctuation, or space",
        "        [^(){}\\[\\]<>\"'`.,;:\\ ]",
        "    )",
        "    # optional line/column suffix (included in path for PathWithPosition::parse_str)",
        "    (:+[0-9]+(:[0-9]+)?|:?\\([0-9]+([,:]?\\ ?[0-9]+)?\\))?",
        ")",
      ],
    ],
    // ホバーおよび Cmd クリックによるパスハイパーリンク検出のタイムアウト（ミリ秒）。
    // タイムアウトに `0` を指定すると、ターミナルのパスハイパーリンクが無効になります。
    "path_hyperlink_timeout_ms": 1,
  },
  "code_actions_on_format": {},
  // タスクの実行に関する設定。
  "tasks": {
    "variables": {},
    "enabled": true,
    // Gram の言語拡張のタスクより LSP のタスクを優先します。
    // エラー、タイムアウト、または通常の実行で LSP タスクが返されなかった場合は、
    // 代わりに Gram の言語拡張のタスクが使われます。
    //
    // その他の Gram タスクは引き続き表示されます:
    // * いずれかのタスク設定ファイルからの Gram タスク
    // * 履歴からの Gram タスク（例: 以前に単発タスクを起動した場合）
    //
    // デフォルト: true
    "prefer_lsp": true,
  },
  // キーが言語名で、値がその言語を使うべき
  // ファイル名または拡張子の配列である
  // オブジェクト。
  //
  // たとえば `foo.notjs` を JavaScript として、
  // `Embargo.lock` を TOML として扱うには:
  //
  // {
  //   "JavaScript": ["notjs"],
  //   "TOML": ["Embargo.lock"]
  // }
  //
  "file_types": {
    "Markdown": [".rules"],
    "Shell Script": [".env.*"],
  },
  // 言語サーバーをインストールするときに使う Node.js と NPM の
  // バージョンの設定。
  //
  // 注: 現在、この設定を変更するには Gram の再起動が必要です。
  "node": {
    // 既定では、Gram は `$PATH` 上の `node` と `npm` を探し、バージョンが十分新しければ
    // 既存の実行ファイルを使います。これを `true` に設定すると、その動作を防ぎ、
    // Gram が常に独自の Node をダウンロードおよびインストールするように
    // 強制できます。
    "ignore_system_version": false,
    // Node と NPM の代替パスを指定することもできます。`path` を指定して
    // `npm_path` を指定しない場合、Gram は `npm` が
    // `${path}/../npm` にあると見なします。
    "path": null,
    "npm_path": null,
  },
  // 拡張機能に付与される権限。
  //
  // このリストをカスタマイズして、拡張機能が実行できることを制限できます。
  "granted_extension_capabilities": [
    { "kind": "process:exec", "command": "*", "args": ["**"] },
    { "kind": "download_file", "host": "*", "path": ["**"] },
    { "kind": "npm:install", "package": "*" },
  ],
  // この言語で補完をどのように処理するかを制御します。
  "completions": {
    // 単語の補完方法を制御します。
    // 大きなドキュメントでは、補完のためにすべての単語を取得できない場合があります。
    //
    // 3 つの値を指定できます:
    // 1. "enabled"
    //   常にドキュメントの単語を LSP 補完とともに補完用に取得する。
    // 2. "fallback"
    //   LSP の応答がエラーまたはタイムアウトした場合にのみ、ドキュメントの単語で補完を表示する。
    // 3. "disabled"
    //   補完のためにドキュメントの単語を取得も補完もしない。
    //   （単語ベースの補完は別のアクションから引き続き要求できます）
    //
    // デフォルト: fallback
    "words": "fallback",
    // 単語ベースの補完を自動的にトリガーするのに必要な最小文字数。
    // この値未満でも、対応するエディターコマンドで単語ベースの補完を手動でトリガーできます。
    //
    // デフォルト: 3
    "words_min_length": 3,
    // LSP の補完を取得するかどうか。
    //
    // デフォルト: true
    "lsp": true,
    // LSP 補完を取得するときに、特定のサーバーの応答をどれだけ待つかを指定します。
    // 0 に設定すると無期限に待機します。
    //
    // デフォルト: 0
    "lsp_fetch_timeout_ms": 0,
    // LSP の補完を受け入れるときに置き換える範囲を制御します。
    //
    // LSP サーバーが `InsertReplaceEdit` 補完を返すときは `insert` と `replace` の 2 つの範囲を提供します。通常、`insert`
    // はカーソル前の単語プレフィックスを含み、`replace` は単語全体を含みます。
    //
    // 実質的にこの設定は、Gram が受け取った範囲のうち `insert` と `replace` のどちらを使うかを変えるだけなので、結果は
    // 基になる LSP サーバーによって異なる場合があります。
    //
    // 指定可能な値:
    // 1. "insert"
    //   LSP 仕様で説明されている `insert` 範囲を使い、カーソル前のテキストを置き換える。
    // 2. "replace"
    //   LSP 仕様で説明されている `replace` 範囲を使い、カーソル前後のテキストを置き換える。
    // 3. "replace_subsequence"
    //   置き換え対象のテキストが補完テキストの部分列である場合は `"replace"` と同様に動作し、
    //   それ以外は `"insert"` と同様に動作する。
    // 4. "replace_suffix"
    //   カーソル後のテキストが補完の接尾辞である場合は `"replace"` と同様に動作し、
    //   それ以外は `"insert"` と同様に動作する。
    "lsp_insert_mode": "replace_suffix",
  },
  // 特定の言語向けの個別設定。
  "languages": {
    "Astro": {
      "language_servers": ["astro-language-server", "..."],
      "prettier": {
        "allowed": true,
        "plugins": ["prettier-plugin-astro"],
      },
    },
    "Blade": {
      "prettier": {
        "allowed": true,
      },
    },
    "C": {
      "format_on_save": "off",
      "use_on_type_format": false,
      "prettier": {
        "allowed": false,
      },
    },
    "C++": {
      "format_on_save": "off",
      "use_on_type_format": false,
      "prettier": {
        "allowed": false,
      },
    },
    "CSS": {
      "prettier": {
        "allowed": true,
      },
    },
    "Dart": {
      "tab_size": 2,
    },
    "Diff": {
      "remove_trailing_whitespace_on_save": false,
      "ensure_final_newline_on_save": false,
    },
    "Elixir": {
      "language_servers": ["elixir-ls", "!expert", "!next-ls", "!lexical", "..."],
    },
    "Elm": {
      "tab_size": 4,
    },
    "Erlang": {
      "language_servers": ["erlang-ls", "!elp", "..."],
    },
    "Git Commit": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "preferred_line_length": 72,
    },
    "Gleam": {
      "language_servers": ["gleam lsp", "..."],
      "tab_size": 2,
    },
    "Go": {
      "hard_tabs": true,
      "code_actions_on_format": {
        "source.organizeImports": true,
      },
      "debuggers": ["Delve"],
    },
    "GraphQL": {
      "prettier": {
        "allowed": true,
      },
    },
    "HEEX": {
      "language_servers": ["elixir-ls", "!expert", "!next-ls", "!lexical", "..."],
    },
    "HTML": {
      "prettier": {
        "allowed": true,
      },
      "language_servers": ["superhtml", "!vscode-html-language-server", "..."],
    },
    "HTML+ERB": {
      "language_servers": ["herb", "!ruby-lsp", "..."],
    },
    "Java": {
      "prettier": {
        "allowed": true,
        "plugins": ["prettier-plugin-java"],
      },
    },
    "JavaScript": {
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": true,
      },
    },
    "JSON": {
      "prettier": {
        "allowed": true,
      },
    },
    "JSONC": {
      "prettier": {
        "allowed": true,
      },
    },
    "JS+ERB": {
      "language_servers": ["!ruby-lsp", "..."],
    },
    "Kotlin": {
      "language_servers": ["!kotlin-language-server", "kotlin-lsp", "..."],
    },
    "LaTeX": {
      "formatter": "language_server",
      "language_servers": ["texlab", "..."],
      "prettier": {
        "allowed": true,
        "plugins": ["prettier-plugin-latex"],
      },
    },
    "Markdown": {
      "language_servers": ["!zk", "..."],
      "format_on_save": "off",
      "use_on_type_format": false,
      "remove_trailing_whitespace_on_save": false,
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
      "prettier": {
        "allowed": true,
      },
    },
    "Nix": {
      "language_servers": ["nil", "!nixd", "..."],
    },
    "PHP": {
      "language_servers": ["phpactor", "!intelephense", "!phptools", "..."],
      "prettier": {
        "allowed": true,
        "plugins": ["@prettier/plugin-php"],
        "parser": "php",
      },
    },
    "Plain Text": {
      "allow_rewrap": "anywhere",
      "soft_wrap": "editor_width",
    },
    "Proto": {
      "language_servers": ["buf", "!protols", "!protobuf-language-server", "..."],
    },
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "debuggers": ["Debugpy"],
      "language_servers": ["basedpyright", "ruff", "!ty", "!pyrefly", "!pyright", "!pylsp", "..."],
    },
    "Ruby": {
      "language_servers": ["solargraph", "!ruby-lsp", "!rubocop", "!sorbet", "!steep", "..."],
    },
    "Rust": {
      "debuggers": ["CodeLLDB"],
    },
    "SCSS": {
      "prettier": {
        "allowed": true,
      },
    },
    "Starlark": {
      "language_servers": ["starpls", "!buck2-lsp", "..."],
    },
    "SuperHTML": {
      "language_servers": ["superhtml", "!vscode-html-language-server", "..."],
      "formatter": "language_server",
    },
    "Svelte": {
      "language_servers": ["svelte-language-server", "..."],
      "prettier": {
        "allowed": true,
        "plugins": ["prettier-plugin-svelte"],
      },
    },
    "TOML": {
      "language_servers": ["!taplo", "tombi", "..."],
    },
    "TSX": {
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": true,
      },
    },
    "Twig": {
      "prettier": {
        "allowed": true,
      },
    },
    "TypeScript": {
      "language_servers": ["!typescript-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": true,
      },
    },
    "SystemVerilog": {
      "format_on_save": "off",
      "language_servers": ["!slang", "..."],
      "use_on_type_format": false,
    },
    "Vue.js": {
      "language_servers": ["vue-language-server", "vtsls", "..."],
      "prettier": {
        "allowed": true,
      },
    },
    "XML": {
      "prettier": {
        "allowed": true,
        "plugins": ["@prettier/plugin-xml"],
      },
    },
    "YAML": {
      "prettier": {
        "allowed": true,
      },
    },
    "YAML+ERB": {
      "language_servers": ["!ruby-lsp", "..."],
    },
    "Zig": {
      "language_servers": ["zls", "..."],
    },
  },
  "session": {
    // 再起動時に未保存のバッファーを復元するかどうか。
    //
    // true の場合、アプリケーションを閉じるときにダーティなファイルを
    // 保存するか破棄するかを確認されません。
    //
    // デフォルト: true
    "restore_unsaved_buffers": true,
  },
  // Gram の Prettier 統合に関する設定。
  // Prettier によるフォーマットを有効/無効にし、
  // プロジェクトレベルの Prettier が見つからない場合に使う既定の Prettier を設定できます。
  "prettier": {
    // 指定した言語で Prettier によるフォーマットを有効にするかどうか。
    "allowed": false,
    // 指定した言語のファイルをフォーマットするとき、Prettier 統合に特定のパーサー名を強制的に使わせます。
    "plugins": [],
    // 既定の Prettier オプション。書式は package.json の Prettier セクションと同じです。
    // プロジェクトが package.json 経由で Prettier をインストールしている場合、これらのオプションは無視されます。
    // "trailingComma": "es5",
    // "tabWidth": 4,
    // "semi": false,
    // "singleQuote": true
    // 空でない文字列を設定すると、Prettier 統合に特定のパーサー名を
    // 強制的に使わせます。
    "parser": "",
  },
  // JSX タグの自動閉じに関する設定。
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  // LSP 固有の設定。
  "lsp": {
    // ここでは LSP 名をキーとして指定します。
    // "rust-analyzer": {
    //     // rust-analyzer 統合の特別なフラグで、サーバー提供のタスクを使います
    //     enable_lsp_tasks": true,
    //     // これらの初期化オプションは Gram の既定値にマージされます
    //     "initialization_options": {
    //         "check": {
    //             "command": "clippy" // rust-analyzer.check.command（デフォルト: "check"）
    //         }
    //     }
    // }
  },
  // DAP 固有の設定。
  "dap": {
    // ここでは DAP 名をキーとして指定します。
    "CodeLLDB": {
      "env": {
        "RUST_LOG": "info",
      },
    },
  },
  // 言語サーバーの共通設定。
  "global_lsp_settings": {
    // ステータスバーに LSP サーバーのボタンを表示するか。
    "button": true,
  },
  // Jupyter の設定
  "jupyter": {
    "enabled": true,
    "kernel_selections": {},
    // 言語名をキー、カーネル名を値として指定します。
    // "kernel_selections": {
    //    "python": "conda-base"
    //    "typescript": "deno"
    // }
  },
  // REPL の設定。
  "repl": {
    // REPL のスクロールバックバッファーに保持する最大列数。
    // [20, 512] の範囲に制限されます。
    "max_columns": 128,
    // REPL のスクロールバックバッファーに保持する最大行数。
    // [4, 256] の範囲に制限されます。
    "max_lines": 32,
  },
  // Vim の設定
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": false,
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 200,
    "custom_digraphs": {},
    // 各モードのカーソル形状。
    // モードをキー、形状を値として指定します。
    // モードは "normal"、"replace"、"insert"、"visual" のいずれかです。
    // 形状は "block"、"bar"、"underline"、"hollow" のいずれかです。
    "cursor_shape": {},
  },
  // which-key ポップアップの設定
  "which_key": {
    // キーの組み合わせを押し続けたときに which-key ポップアップを表示するか。
    "enabled": true,
    // which-key ポップアップを表示するまでの遅延（ミリ秒）。
    "delay_ms": 500,
  },
  // Gram Stable を使うときに適用する設定オーバーライド。
  // 主に Gram の複数インスタンスを管理する開発者に便利です。
  "stable": {
    // "theme": "Andromeda"
  },
  // Gram Dev を使うときに適用する設定オーバーライド。
  // 主に Gram の複数インスタンスを管理する開発者に便利です。
  "dev": {
    // "theme": "Andromeda"
  },
  // Linux を使うときに適用する設定オーバーライド。
  "linux": {},
  // macOS を使うときに適用する設定オーバーライド。
  "macos": {},
  // Windows を使うときに適用する設定オーバーライド。
  "windows": {
    "languages": {
      "PHP": {
        "language_servers": ["intelephense", "!phpactor", "!phptools", "..."],
      },
    },
  },
  // 行インジケーターに完全なラベルと短いラベルのどちらを表示するか
  //
  // 値:
  //   - `short`: "2 s, 15 l, 32 c"
  //   - `long`: "2 selections, 15 lines, 32 characters"
  // デフォルト: long
  "line_indicator_format": "long",
  // 使用するプロキシを設定します。プロキシプロトコルは URI スキームで指定します。
  //
  // 対応 URI スキーム: `http`、`https`、`socks4`、`socks4a`、`socks5`、
  // `socks5h`。スキームを指定しない場合は `http` が使われます。
  //
  // 既定ではプロキシは使われず、Gram は環境変数からプロキシ設定を
  // 取得しようとします。特定のホストをプロキシ対象外にする場合は、
  // `no_proxy` 環境変数を設定し、カンマ区切りのリストを指定してください。
  //
  // 例:
  //   - "proxy": "socks5h://localhost:10808"
  //   - "proxy": "http://127.0.0.1:10809"
  "proxy": "",
  // コマンドパレットのエイリアスを設定します。
  // このオブジェクトのキーをクエリとして入力すると、その値が代わりに使われます。
  //
  // 例:
  // {
  //   "W": "workspace::Save"
  // }
  "command_aliases": {},
  // ssh_connections は ssh 接続の配列です。
  // これらはコマンドパレットの `project: Open Remote` から設定できます。
  // Gram の ssh サポートは ~/.ssh からも設定を読み取ります。
  // 例:
  // [
  //   {
  //     "host": "example-box",
  //     // "port": 22, "username": "test", "args": ["-i", "/home/user/.ssh/id_rsa"]
  //     "projects": [
  //       {
  //         "paths": ["/home/user/code/gram"]
  //       }
  //     ]
  //   }
  // ]
  "ssh_connections": [],
  // ssh 接続の情報源として ~/.ssh/config を読み取るか。
  "read_ssh_config": true,
  "debugger": {
    "stepping_granularity": "line",
    "save_breakpoints": true,
    "timeout": 2000,
    "dock": "bottom",
    "log_dap_communications": true,
    "format_dap_log_messages": true,
    "button": true,
  },
  // 設定プロファイルを任意の数だけ構成します。プロファイルは、
  // 既存のユーザー設定の上に一時的に適用され、
  // `settings profile selector: toggle` から選択すると使われます。
  // 例:
  // "profiles": {
  //   "Presenting": {
  //     "buffer_font_size": 20.0,
  //     "theme": "One Light",
  //     "ui_font_size": 20.0
  //   },
  //   "Python (ty)": {
  //     "languages": {
  //       "Python": {
  //         "language_servers": ["ty"]
  //       }
  //     }
  //   }
  // }
  "profiles": {},

  // ログスコープと希望するログレベルのマップ。
  // うるさいログを除外したり、より詳細なログを有効にしたりするのに便利です。
  //
  // 例: {"log": {"client": "warn"}}
  "log": {},
}
